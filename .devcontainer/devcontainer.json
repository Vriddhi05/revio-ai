{
  "name": "REVIO synthetic assessment demo",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "64gb"
  },
  "onCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "services/api/.venv/bin/python services/api/scripts/codespaces_bootstrap.py start",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "REVIO demonstration API",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  }
}
