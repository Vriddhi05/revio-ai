# Copy into service-specific local env files when you need to change defaults.
# Do not place API keys or production credentials here.
APP_ENV=development
DATABASE_URL=sqlite:///./revio.db
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Optional local review intelligence settings (used by services/api/.env).
REVIO_SENTIMENT_PROVIDER=fallback
REVIO_ASPECT_PROVIDER=rules
