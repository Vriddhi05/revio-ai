# Local SQLite is the default. Uncomment only if you want to override its path.
# DATABASE_URL=sqlite:///./revio.db
APP_ENV=development
APP_NAME=REVIO API
REVIO_SENTIMENT_PROVIDER=fallback
REVIO_ASPECT_PROVIDER=rules
CRISIS_WINDOW_DAYS=14
CRISIS_MINIMUM_SAMPLE=3
CRISIS_NEGATIVE_RATE_RISE=0.25
CRISIS_SIMILAR_COMPLAINT_MINIMUM=3
CRISIS_CROSS_LOCATION_MINIMUM=2
CRISIS_CUSTOMER_REPEAT_MINIMUM=2
KNOWLEDGE_EMBEDDING_MODEL=intfloat/multilingual-e5-small
KNOWLEDGE_EMBEDDING_REVISION=fd1525a9fd15316a2d503bf26ab031a61d056e98
KNOWLEDGE_VECTOR_BACKEND=auto
KNOWLEDGE_UPLOAD_MAX_BYTES=10485760
KNOWLEDGE_CHUNK_CHARS=900
KNOWLEDGE_CHUNK_OVERLAP=140
KNOWLEDGE_CHUNK_MAX_TOKENS=480
KNOWLEDGE_CHUNK_TOKEN_OVERLAP=64
KNOWLEDGE_MIN_SIMILARITY=0.822045
KNOWLEDGE_MAX_EXTRACTED_CHARS=2000000
