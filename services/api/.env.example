# Local SQLite is the default. Uncomment only if you want to override its path.
# DATABASE_URL=sqlite:///./revio.db
APP_ENV=development
APP_NAME=REVIO API
REVIO_SENTIMENT_PROVIDER=fallback
REVIO_ASPECT_PROVIDER=rules
CRISIS_WINDOW_DAYS=14
CRISIS_MINIMUM_SAMPLE=3
CRISIS_NEGATIVE_RATE_RISE=0.25
CRISIS_SIMILAR_COMPLAINT_MINIMUM=3
CRISIS_CROSS_LOCATION_MINIMUM=2
CRISIS_CUSTOMER_REPEAT_MINIMUM=2
